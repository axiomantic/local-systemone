# Device for the Laya model. Empty = auto-detect (cuda > mps > cpu).
LAYA_DEVICE=

# Warm the model(s) at startup so no request pays a cold load.
LAYA_PRELOAD=1

# Which checkpoints to keep resident. Empty = all three (english, multilingual,
# typed-decisions). Set e.g. "english" to cut memory on a laptop.
LAYA_PRELOAD_MODELS=

# Opt in to typed-decisions workflow auto-detection (off by default upstream).
LAYA_AUTO_TASK_DETECTION=0

# Run without the model (deterministic stub) to smoke-test the wiring.
LAYA_MOCK=0

# HTTP bind.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# HuggingFace token for gated checkpoints (optional).
HF_TOKEN=

# MCP client side: where the `laya-mcp` server forwards tool calls. Normally set
# inside each assistant's MCP config `env` block, not here.
# LAYA_BASE_URL=http://127.0.0.1:8000